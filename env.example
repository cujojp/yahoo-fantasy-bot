# Local Development Environment Variables for Yahoo Fantasy Bot
# Copy this file and rename to .env, then fill in your actual values

# Database Configuration (for local PostgreSQL)
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/yahoo_fantasy_bot?user=dev_user&password=dev_password

# Yahoo API Credentials (Required)
# Get these from Yahoo Developer Console: https://developer.yahoo.com/apps/
YAHOO_CLIENT_ID=your_yahoo_client_id_here
YAHOO_CLIENT_SECRET=your_yahoo_client_secret_here

# Yahoo Fantasy League Information (Required)
# Game Keys: NFL=423, NBA=428, MLB=431, NHL=427
YAHOO_GAME_KEY=423
YAHOO_LEAGUE_ID=your_league_id_here

# Server Configuration
PORT=8080

# Optional: Messaging Services (leave empty if not using)
# GroupMe Bot ID (optional)
GROUP_ME_BOT_ID=

# Discord Webhook URL (optional)
DISCORD_WEBHOOK_URL=

# Slack Webhook URL (optional)
SLACK_WEBHOOK_URL=

# OpenAI API Key (optional) - for generating Schefter-style tweets
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Model used for those tweets. Override to move models without a code change.
OPENAI_MODEL=gpt-4o

# Sleeper's player table is ~15MB and is used to match Yahoo player ids and cross-check
# injuries. Set to false to skip it on a small container. See OPENAI_INTEGRATION.md.
SLEEPER_PLAYER_MAP=true
